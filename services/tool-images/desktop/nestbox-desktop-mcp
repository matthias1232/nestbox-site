# --------------------------------------------------------------------------
# JSON-RPC over stdio
# --------------------------------------------------------------------------


def ok(identifier: Any, result: Any) -> dict:
    """A JSON-RPC success answer."""
    return {"jsonrpc": "2.0", "id": identifier, "result": result}


def error(identifier: Any, code: int, message: str) -> dict:
    """A JSON-RPC protocol error, for a request that is wrong, not a tool that failed."""
    return {"jsonrpc": "2.0", "id": identifier, "error": {"code": code, "message": message}}


def tool_error(identifier: Any, message: str) -> dict:
    """A tool that could not do its job: a result with `isError`, so the model may retry."""
    return ok(identifier, {"content": [{"type": "text", "text": message}], "isError": True})


def handle(request: Any) -> dict | None:
    """One JSON-RPC request to (answer or None). Never raises.

    `None` means "send nothing": a notification has no id to answer, and the
    MCP handshake sends one (`notifications/initialized`) that must not get a
    reply.
    """
    if not isinstance(request, dict):
        return error(None, -32600, "expected one JSON-RPC request object")
    method = request.get("method")
    identifier = request.get("id")
    params = request.get("params")
    if not isinstance(params, dict):
        params = {}
    if not isinstance(method, str):
        return error(identifier, -32600, "method must be a string")

    if method.startswith("notifications/"):
        return None

    if method == "initialize":
        requested = params.get("protocolVersion")
        version = requested if requested in SUPPORTED_PROTOCOLS else PROTOCOL_VERSION
        return ok(
            identifier,
            {
                "protocolVersion": version,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
                "instructions": INSTRUCTIONS,
            },
        )

    if method == "ping":
        return ok(identifier, {})

    if method == "tools/list":
        return ok(identifier, {"tools": TOOLS})

    if method == "tools/call":
        name = str(params.get("name") or "")
        handler = HANDLERS.get(name)
        if handler is None:
            return error(identifier, -32602, f"unknown tool: {name}")
        arguments = params.get("arguments")
        if arguments is None:
            arguments = {}
        if not isinstance(arguments, dict):
            return error(identifier, -32602, "arguments must be an object")
        try:
            content = handler(arguments)
        except Failure as exc:
            return tool_error(identifier, str(exc))
        except (OSError, ValueError, KeyError) as exc:
            return tool_error(identifier, f"failed: {exc}")
        return ok(identifier, {"content": content, "isError": False})

    if identifier is None:
        return None
    return error(identifier, -32601, f"method not found: {method}")


def serve(stdin: IO[str], stdout: IO[str]) -> None:
    """Read one JSON-RPC message per line and answer it on one line.

    Line-delimited because that is what a stdio MCP client speaks. Nothing but
    an answer is ever written to stdout: a log line there would be a protocol
    error, so diagnostics go to stderr.
    """
    for raw in stdin:
        line = raw.strip()
        if not line:
            continue
        try:
            request = json.loads(line)
        except ValueError:
            _send(stdout, error(None, -32700, "parse error"))
            continue
        answer = handle(request)
        if answer is not None:
            _send(stdout, answer)


def _send(stdout: IO[str], answer: dict) -> None:
    """Write one answer line and flush it, so a waiting client sees it at once."""
    stdout.write(json.dumps(answer, ensure_ascii=False) + "\n")
    stdout.flush()


def main() -> int:
    """Run the stdio server until the client closes the pipe."""
    print(f"{SERVER_NAME} {SERVER_VERSION} on DISPLAY={DISPLAY}", file=sys.stderr, flush=True)
    try:
        serve(sys.stdin, sys.stdout)
    except (BrokenPipeError, KeyboardInterrupt):
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
