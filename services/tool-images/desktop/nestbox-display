# Commands
# --------------------------------------------------------------------------


def command_get(arguments: list[str]) -> dict:
    """`get` — the layout that is on screen now."""
    if arguments:
        raise Failure("get takes no arguments")
    return read_layout()


def command_set(arguments: list[str]) -> dict:
    """`set '<json>'` — apply a whole layout, or read it from standard input."""
    text = " ".join(arguments).strip() if arguments else sys.stdin.read()
    if not text:
        raise Failure("set needs a layout as its argument or on standard input")
    try:
        layout = parse_layout(text)
    except ValueError as exc:
        raise Failure(str(exc)) from exc
    return apply_layout(layout)


def command_add(arguments: list[str]) -> dict:
    """`add <width>x<height> [right|below]` — one more monitor at the edge."""
    size, position = _parse_add(arguments)
    return apply_layout(append_monitor(read_layout(), size[0], size[1], position))


def command_remove(arguments: list[str]) -> dict:
    """`remove <id>` — drop a monitor; the last one stays."""
    if len(arguments) != 1:
        raise Failure("remove needs a monitor id")
    layout = read_layout()
    if len(layout["monitors"]) == 1:
        raise Failure("a layout needs at least one monitor")
    monitor = find_monitor(layout, arguments[0])
    layout["monitors"] = [entry for entry in layout["monitors"] if entry is not monitor]
    return apply_layout(strip_layout(layout))


def command_resize(arguments: list[str]) -> dict:
    """`resize <id> <width>x<height>` — change one monitor's size."""
    if len(arguments) != 2:
        raise Failure("resize needs a monitor id and a size like 1920x1080")
    size = _parse_size(arguments[1])
    layout = read_layout()
    monitor = find_monitor(layout, arguments[0])
    monitor["width"], monitor["height"] = size
    return apply_layout(strip_layout(layout))


def command_move(arguments: list[str]) -> dict:
    """`move <id> <x> <y>` — put a monitor at a position; it must still touch."""
    if len(arguments) != 3:
        raise Failure("move needs a monitor id and an x and a y")
    try:
        x, y = int(arguments[1]), int(arguments[2])
    except ValueError as exc:
        raise Failure("x and y must be whole numbers") from exc
    layout = read_layout()
    monitor = find_monitor(layout, arguments[0])
    monitor["x"], monitor["y"] = x, y
    return apply_layout(strip_layout(layout))


def command_mode(arguments: list[str]) -> dict:
    """`mode separate|stretched` — separate screens or one stretched screen."""
    if len(arguments) != 1 or arguments[0] not in (MODE_SEPARATE, MODE_STRETCHED):
        raise Failure('mode needs "separate" or "stretched"')
    layout = read_layout()
    layout["mode"] = arguments[0]
    return apply_layout(strip_layout(layout))


def command_span(arguments: list[str]) -> dict:
    """`span <window-class>` — one window over every monitor, un-maximized first.

    A maximized window ignores a resize request in most window managers, so the
    maximized state is removed before the geometry is set.
    """
    if len(arguments) != 1:
        raise Failure("span needs a window class")
    window = arguments[0]
    layout = read_layout()
    width, height = layout["framebuffer"]
    wmctrl(["-x", "-r", window, "-b", "remove,maximized_vert,maximized_horz"])
    wmctrl(["-x", "-r", window, "-e", f"0,0,0,{width},{height}"])
    return {
        "ok": True,
        "window": window,
        "geometry": {"x": 0, "y": 0, "width": width, "height": height},
        "monitors": len(layout["monitors"]),
    }


def command_place(arguments: list[str]) -> dict:
    """`place <window-class> <monitor-id> [maximize]` — move a window to a monitor."""
    if len(arguments) not in (2, 3):
        raise Failure("place needs a window class, a monitor id and optionally maximize")
    window = arguments[0]
    maximize = len(arguments) == 3 and arguments[2] == "maximize"
    if len(arguments) == 3 and not maximize:
        raise Failure('the third argument of place must be "maximize"')
    layout = read_layout()
    monitor = find_monitor(layout, arguments[1])
    wmctrl(["-x", "-r", window, "-b", "remove,maximized_vert,maximized_horz"])
    wmctrl(
        [
            "-x",
            "-r",
            window,
            "-e",
            f"0,{monitor['x']},{monitor['y']},{monitor['width']},{monitor['height']}",
        ]
    )
    if maximize:
        wmctrl(["-x", "-r", window, "-b", "add,maximized_vert,maximized_horz"])
    return {
        "ok": True,
        "window": window,
        "monitor": monitor["id"],
        "geometry": {
            "x": monitor["x"],
            "y": monitor["y"],
            "width": monitor["width"],
            "height": monitor["height"],
        },
        "maximized": maximize,
    }


def wmctrl(arguments: list[str]) -> str:
    """Run `wmctrl`, turning its "no window" answer into a readable failure."""
    result = _completed(["wmctrl", *arguments], check=False)
    if result.returncode != 0:
        message = (result.stderr or result.stdout).strip() or f"exit {result.returncode}"
        if "No window" in message:
            message = f"no window matches {arguments[2]}"
        raise Failure(f"wmctrl: {message}")
    return result.stdout


def _parse_size(text: str) -> tuple[int, int]:
    """A size like `1920x1080` as two numbers, with the limits checked."""
    match = re.match(r"^(\d+)x(\d+)$", text.strip())
    if not match:
        raise Failure("a size reads like 1920x1080")
    width, height = int(match.group(1)), int(match.group(2))
    if not MIN_SIDE <= width <= MAX_SIDE or not MIN_SIDE <= height <= MAX_SIDE:
        raise Failure(f"width and height must be from {MIN_SIDE} to {MAX_SIDE}")
    return width, height


def _parse_add(arguments: list[str]) -> tuple[tuple[int, int], str]:
    """The size and the position of an `add` command."""
    if len(arguments) not in (1, 2):
        raise Failure("add needs a size like 1920x1080 and optionally right or below")
    size = _parse_size(arguments[0])
    position = arguments[1] if len(arguments) == 2 else "right"
    if position not in ("right", "below"):
        raise Failure('the position of add must be "right" or "below"')
    return size, position


COMMANDS = {
    "get": command_get,
    "set": command_set,
    "add": command_add,
    "remove": command_remove,
    "resize": command_resize,
    "move": command_move,
    "mode": command_mode,
    "span": command_span,
    "place": command_place,
}

USAGE = """usage: nestbox-display <command> [arguments]

  get
  set '<layout json>'          (or the layout on standard input)
  add <width>x<height> [right|below]
  remove <id>
  resize <id> <width>x<height>
  move <id> <x> <y>
  mode separate|stretched
  span <window-class>
  place <window-class> <monitor-id> [maximize]

Every command prints one JSON line; a failure prints {"error": "..."} and
exits 1. DISPLAY defaults to :1; the layout is saved in
$HOME/.config/nestbox-display.json.
"""


def main(argv: list[str]) -> int:
    """Dispatch one command and print its one JSON line."""
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0 if argv else 2
    handler = COMMANDS.get(argv[0])
    if handler is None:
        print(json.dumps({"error": f"unknown command {argv[0]}"}))
        return 1
    try:
        result = handler(argv[1:])
    except Failure as exc:
        print(json.dumps({"error": str(exc)}))
        return 1
    except ValueError as exc:
        print(json.dumps({"error": str(exc)}))
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
